generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  transactions  Transaction[]
  leads         Lead[]
  stockItems    StockItem[]
  stockChanges  StockChange[]

  @@map("user")
}

model Member {
  id               String        @id @default(cuid())
  name             String        @unique
  createdAt        DateTime      @default(now())
  paidTransactions Transaction[] @relation("paidBy")
}

model Profile {
  id                     String           @id @default(cuid())
  slug                   String           @unique
  passwordHash           String
  imageUrl               String?
  showImage              Boolean          @default(true)
  name                   String
  title                  String?
  title2                 String?
  colorScheme            String           @default("forest")
  iban                   String?
  ibanEnabled            Boolean          @default(true)
  callNumber             String?
  callEnabled            Boolean          @default(true)
  callFullWidth          Boolean          @default(false)
  whatsappNumber         String?
  whatsappEnabled        Boolean          @default(true)
  whatsappFullWidth      Boolean          @default(false)
  email                  String?
  emailEnabled           Boolean          @default(true)
  emailFullWidth         Boolean          @default(false)
  linkedinUrl            String?
  linkedinEnabled        Boolean          @default(true)
  linkedinFullWidth      Boolean          @default(false)
  instagramUrl           String?
  instagramEnabled       Boolean          @default(true)
  instagramFullWidth     Boolean          @default(false)
  locationUrl            String?
  locationEnabled        Boolean          @default(true)
  locationFullWidth      Boolean          @default(true)
  googleReviewUrl        String?
  contactEnabled         Boolean          @default(true)
  contactFullWidth       Boolean          @default(true)
  facilitiesHeading      String           @default("Bağlantılar")
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  facilities             ProfileFacility[]
  sessions               ProfileSession[]
}

model ProfileFacility {
  id        String  @id @default(cuid())
  name      String
  url       String
  sortOrder Int     @default(0)
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
}

model ProfileSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, expiresAt])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime

  @@index([identifier])
  @@map("verification")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum LeadType {
  MESSAGE
  CALL
  MAIL
  ORDER
}

model Transaction {
  id             String          @id @default(cuid())
  type           TransactionType
  amountCents    Int
  description    String
  date           DateTime
  createdAt      DateTime        @default(now())
  createdByName  String          @default("Bilinmiyor")
  paidByMemberId String?
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  paidByMember   Member?         @relation("paidBy", fields: [paidByMemberId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([paidByMemberId])
}

model Lead {
  id           String   @id @default(cuid())
  type         LeadType
  personName   String
  contactInfo  String?
  followUpAt   DateTime?
  details      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, followUpAt])
}

model StockItem {
  id        String        @id @default(cuid())
  name      String
  quantity  Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  changes   StockChange[]

  @@unique([userId, name])
  @@index([userId, updatedAt])
}

model StockChange {
  id           String    @id @default(cuid())
  amount       Int
  title        String
  createdAt    DateTime  @default(now())
  createdByName String   @default("Bilinmiyor")
  stockItemId  String
  stockItem    StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([stockItemId, createdAt])
}

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  contact   String
  message   String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([createdAt])
}
